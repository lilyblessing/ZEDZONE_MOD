<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>PadSortProbe</AssemblyName>
    <RootNamespace>PadSortProbe</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>CS0436;CS0618</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GAME_DIR)' != ''">$(GAME_DIR)</GameDir>
    <GameDir Condition="'$(GAME_DIR)' == ''">D:\SteamLibrary\steamapps\common\ZED ZONE</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.Common.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>

    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引用 TS 插件以检测 PadLayerPin 组件是否随实例复制 -->
    <Reference Include="TeleportStationPlugin">
      <HintPath>$(GameDir)\BepInEx\plugins\TeleportStation\TeleportStationPlugin.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 跨 mod 共享源码（../../Shared：Reflect/SharedLog 等） -->
    <Compile Include="..\..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Using Include="ZedZoneShared" />
  </ItemGroup>

</Project>